#!/usr/bin/env bash
# Manage the development instance belonging to this checkout.
set -euo pipefail

usage() {
    cat <<'HELP'
Usage: dev/ha/run [start|restart|recreate|logs|status|stop]

  start     Start HA and wait for its web server (default)
  restart   Load changed integration Python files
  recreate  Load changed YAML, Compose settings, or image
  logs      Follow HA logs; Ctrl+C stops following
  status    Show container status
  stop      Remove the container, keeping the login and settings

Set HA_TEST_PORT and COMPOSE_PROJECT_NAME in dev/ha/.env to keep local choices.
If Docker requires root access, run this script with sudo.
HELP
}

if (( $# > 1 )); then
    usage >&2
    exit 2
fi
command_name=${1:-start}
case "$command_name" in
    -h|--help|help) usage; exit 0 ;;
    start|restart|recreate|logs|status|stop) ;;
    *) usage >&2; exit 2 ;;
esac

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd -- "$script_dir"

if ! command -v docker >/dev/null || ! docker compose version >/dev/null 2>&1; then
    echo 'Install Docker and its Compose plugin first (see dev/ha/README.md).' >&2
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    echo 'Cannot access Docker. Check that it is running; try sudo if access is denied.' >&2
    exit 1
fi

# Running here makes Compose load this checkout's optional .env consistently.
compose=(docker compose -f "$script_dir/compose.yaml")
case "$command_name" in
    start) "${compose[@]}" up -d --wait --wait-timeout 300 ;;
    restart) "${compose[@]}" restart homeassistant ;;
    recreate) "${compose[@]}" up -d --force-recreate --wait --wait-timeout 300 ;;
    logs) exec "${compose[@]}" logs -f homeassistant ;;
    status) exec "${compose[@]}" ps ;;
    stop) exec "${compose[@]}" down ;;
esac

address=$("${compose[@]}" port homeassistant 8123)
printf 'Dashboard: http://%s/lovelace/toyenbadet\n' "$address"
